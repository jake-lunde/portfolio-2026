{
  "name": "lunde-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:doctor": "node scripts/doctor-tokens.mjs",
    "tokens:watch": "onchange 'tokens/**/*.json' -- npm run tokens:build",
    "text:index": "node scripts/build-text-index.mjs",
    "predev": "npm run tokens:build && npm run cv:build && npm run text:index",
    "prebuild": "npm run tokens:build && npm run cv:build && npm run text:index",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "plugin:build": "node figma-plugin/build.mjs",
    "plugin:watch": "node figma-plugin/build.mjs --watch",
    "test": "node --test figma-plugin/test/*.test.mjs test/*.test.mjs",
    "cv:build": "node scripts/build-cv.mjs",
    "ntsc:build": "sh scripts/ntsc-build.sh",
    "ntsc:bake": "node --experimental-strip-types --no-warnings scripts/ntsc-bake.mjs",
    "figma:map": "node scripts/figma-map.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.5.0",
    "jsonwebtoken": "^9.0.3",
    "motion": "^12.15.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.130.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/nextjs": "^8.6.18",
    "@tokens-studio/sd-transforms": "^1.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "chromatic": "^18.0.1",
    "esbuild": "^0.28.1",
    "onchange": "^7.1.0",
    "pdfkit": "^0.19.1",
    "storybook": "^8.6.18",
    "style-dictionary": "^4.4.0",
    "typescript": "^5.8.3"
  }
}
