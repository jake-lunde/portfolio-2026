  "type": {
    "$description": "Semantic type ramp v1 \u2014 role-named groups of plain size/leading/weight/tracking/family sub-tokens referencing core. Fluid roles (display, heading-1) carry clamp() literals to preserve the site's current responsive behavior. The Desktop/Mobile-mode round-trip representation of the fluid sizes, plus DTCG `typography` composites and Figma text-styles, land in the NEXT phase (do not build here). Two ramps live here: display through mono are CONTENT, and title through wordmark are CHROME \u2014 the OS furniture the pilot five used to hand-assemble from loose core primitives, one role per treatment (Jake's ruling, 2026-08-21).",
    "display": {
      "size": {
        "$value": "clamp(34px, 6vw, 62px)"
      },
      "leading": {
        "$value": "{leading.none}"
      },
      "weight": {
        "$value": "{weight.regular}"
      },
      "tracking": {
        "$value": "0"
      },
      "family": {
        "$value": "{display}"
      }
    },
    "heading-1": {
      "size": {
        "$value": "clamp(28px, 5.5vw, 38px)"
      },
      "leading": {
        "$value": "{leading.tight}"
      },
      "weight": {
        "$value": "{weight.regular}"
      },
      "tracking": {
