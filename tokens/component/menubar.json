{
  "menubar-h": {
    "$value": "34px",
    "$type": "dimension",
    "$description": "The menubar's own height — a component decision, not a layout primitive."
  },
  "menubar": {
    "bg": {
      "$value": "{surface}",
      "$type": "color"
    },
    "border-color": {
      "$value": "{content}",
      "$type": "color"
    },
    "border-width": {
      "$value": "{border-width.default}",
      "$type": "dimension"
    },
    "text": {
      "$type": "typography",
      "$value": "{typography.label}"
    },
    "padding-x": {
      "$value": "14px",
      "$type": "dimension",
      "$description": "OFF-GRID literal (spacing scale is base-4: 4/8/12/16/20/24/32/48). Extracted verbatim from the pre-token CSS for a zero-visual-change migration. Snap to {space.3} (12px) or {space.4} (16px) when a deliberate visual change is approved."
    },
    "gap": {
      "$value": "{spacing.component.lg}",
      "$type": "dimension"
    },
    "wordmark": {
      "text": {
        "$type": "typography",
        "$value": "{typography.wordmark}"
      },
      "version": {
        "text": {
          "$type": "typography",
          "$value": "{typography.label}"
        },
        "margin-left": {
          "$value": "10px",
          "$type": "dimension",
          "$description": "OFF-GRID literal. Snap to {space.2} (8px) or {space.3} (12px) when approved."
        }
      }
    },
    "menu-btn": {
      "text": {
        "$type": "typography",
        "$value": "{typography.menu}"
      },
      "padding-y": {
        "$value": "{space.1}",
        "$type": "dimension"
      },
      "padding-x": {
        "$value": "{space.2}",
        "$type": "dimension"
      },
      "border-width": {
        "$value": "{border-width.subtle}",
        "$type": "dimension"
      }
    },
    "menu-glyph-btn": {
      "padding": {
        "$value": "3px",
        "$type": "dimension",
        "$description": "OFF-GRID literal. Snap to {space.1} (4px) when approved."
      }
    }
  }
}
